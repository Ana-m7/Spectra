# Port the API listens on (Render sets this automatically in production)
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spectra

# Secret used to sign JWTs — use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Base URL of the Flask ML microservice (no trailing slash)
# Local: http://localhost:5001 | Production: your Render ML service URL
FLASK_URL=http://localhost:5001

# Origin of the deployed frontend, for CORS (no trailing slash)
# e.g. https://spectra.vercel.app — http://localhost:3000 is always allowed
CLIENT_ORIGIN=
